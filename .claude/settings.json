{
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Read(**)",
      "Write(data/staging/**)",
      "Write(out/**)",
      "Edit(out/**)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(git push *)",
      "Edit(data/accounts.csv)",
      "Edit(data/signals.csv)",
      "Edit(data/scored.csv)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
